# Time Vision Marketing Studio — variabili d'ambiente
#
# Copia in .env.local per lo sviluppo. Su Vercel: `vercel env add <NOME>`
# una chiave alla volta, per preview e production.
#
# L'app gira end-to-end sui mock anche senza nessuna di queste chiavi:
# aggiungile una alla volta, verificando dopo ciascuna.

# --- Autenticazione ------------------------------------------------
# Senza queste tre, la console usa un editor di sviluppo e non chiede login.
NEXTAUTH_URL=https://tv-socialstudio.vercel.app
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chi amministra il team il primo giorno, prima che esista un profilo con la
# spunta admin: indirizzi @timevision.it separati da virgola. Da qui in poi
# si invita e si cambiano i ruoli dalla pagina Team e ruoli, senza SQL.
STUDIO_ADMIN_EMAILS=

# --- Database ------------------------------------------------------
# Senza queste due, i dati stanno in memoria e non sopravvivono al riavvio.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Generazione del copy -------------------------------------------
# Senza questa, il copy viene da un generatore deterministico locale.
ANTHROPIC_API_KEY=

# --- Figma (sola lettura) -------------------------------------------
# Personal access token di un account Figma Pro.
FIGMA_TOKEN=
FIGMA_FILE_KEY=

# --- LinkedIn --------------------------------------------------------
# Richiede un'app LinkedIn approvata con w_organization_social e un
# amministratore della pagina Time Vision che la autorizzi.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
# Versione mensile della Posts API (YYYYMM). Vuota vale 202506: se LinkedIn
# la ritira, basta alzarla qui.
LINKEDIN_API_VERSION=

# --- Instagram -------------------------------------------------------
# Instagram Graph API tramite un account Facebook Business collegato.
# L'immagine viene letta da Instagram all'indirizzo pubblico dell'app
# (NEXTAUTH_URL): il deployment deve essere raggiungibile da fuori.
IG_ACCESS_TOKEN=
IG_USER_ID=
# Versione della Graph API. Vuota vale v21.0.
IG_GRAPH_VERSION=

# --- Pubblicazione programmata ---------------------------------------
# Segreto condiviso che protegge la rotta cron.
CRON_SECRET=

# --- Email di approvazione (Resend) ------------------------------------
# Chiave API di Resend. Senza, le notifiche non partono e finiscono nel log:
# il flusso di approvazione funziona comunque. MAIL_FROM deve essere un
# mittente verificato nel dominio Resend, es. "TV Social Studio <studio@timevision.it>".
RESEND_API_KEY=
MAIL_FROM=

# --- Visual generati --------------------------------------------------
# Chi genera le immagini: `gamma` o `flux`. Vuoto sceglie da se': Gamma se
# GAMMA_API_KEY c'e', altrimenti flux.
#   gamma — 2048px, capisce l'italiano, consuma crediti. E' il migliore.
#   flux  — Pollinations, gratuito, 768px, vuole il prompt in inglese
#           (lo traduce ANTHROPIC_API_KEY, se c'e').
VISUAL_ENGINE=

# Solo per flux. Senza token genera lo stesso col modello gratuito `sana`;
# servono ad aprire il catalogo dei modelli migliori. Attenzione: senza token
# chiedere un modello diverso non da' errore, da' `sana` in silenzio.
POLLINATIONS_TOKEN=
VISUAL_MODEL=

# --- Gamma (documenti multipagina) -----------------------------------
# Chiave API dalle impostazioni del workspace Gamma. E' distinta dal
# connettore Gamma: averne uno non implica avere l'altra.
# Ogni generazione consuma crediti del piano Pro. Serve ai documenti
# multipagina e, come motore predefinito, ai visual generati.
GAMMA_API_KEY=

# --- Export via Chromium (poster in PDF e video) -----------------------
# In locale serve il Chrome installato. Su Vercel va lasciata vuota: si usa
# il binario di @sparticuz/chromium incluso nel deploy.
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=
